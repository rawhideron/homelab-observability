# Versions current on 2026-11-17, before vendors shipped fixes for that day's
# Java SE patch. A published build that differs from its baseline fires
# JavaPatchAvailable. After rolling it out, set the baseline to it.
UBUNTU_PACKAGES="openjdk-21-jre-headless openjdk-11-jre-headless"
TEMURIN_BASELINES="11=11.0.33+10 21=21.0.13+9-LTS 25=25.0.5+8-LTS"
KEYCLOAK_BASELINE="26.8.2"
