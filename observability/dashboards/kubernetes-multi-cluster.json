    {
      "type": "timeseries",
      "title": "Node network",
      "description": "Receive above zero, transmit below. Nodes whose kubelet reports no node-level network stats (k3s) show the sum of their pods' traffic instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (k8s_node_name) (rate(k8s_node_network_io_bytes_total{k8s_cluster_name=\"$cluster\", k8s_node_name=~\"$node\", direction=\"receive\"}[$__rate_interval])) or sum by (k8s_node_name) (rate(k8s_pod_network_io_bytes_total{k8s_cluster_name=\"$cluster\", k8s_node_name=~\"$node\", direction=\"receive\"}[$__rate_interval])))",
          "legendFormat": "{{k8s_node_name}} rx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-(sum by (k8s_node_name) (rate(k8s_node_network_io_bytes_total{k8s_cluster_name=\"$cluster\", k8s_node_name=~\"$node\", direction=\"transmit\"}[$__rate_interval])) or sum by (k8s_node_name) (rate(k8s_pod_network_io_bytes_total{k8s_cluster_name=\"$cluster\", k8s_node_name=~\"$node\", direction=\"transmit\"}[$__rate_interval])))",
          "legendFormat": "{{k8s_node_name}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11
    },
